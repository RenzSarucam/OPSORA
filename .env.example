# Copy this file to .env before running `docker compose up -d --build`.
# Never commit the real .env file.
#
# For a REAL deploy (not localhost), set APP_URL / FRONTEND_URL /
# NEXT_PUBLIC_API_URL to your actual public domains BEFORE building —
# NEXT_PUBLIC_API_URL is baked into the frontend at build time, so changing
# it later requires rebuilding the frontend image.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Set to true once served over HTTPS.
SESSION_SECURE_COOKIE=false
# Set to * when running behind a reverse proxy / load balancer (e.g. Nginx,
# Cloudflare) so HTTPS detection and client IPs are read correctly. Required
# if you're using the bundled nginx service or an external one (see below).
TRUSTED_PROXIES=

# Port the bundled `nginx` service publishes (see docker-compose.yml).
# Point your existing host-level nginx (or whatever already routes other
# projects on this server) at http://127.0.0.1:<this port> instead of
# exposing frontend/backend individually. When using it as your public
# entry point, set FRONTEND_URL/APP_URL to that public domain and
# NEXT_PUBLIC_API_URL="" (empty — same-origin, routed via nginx's /api/).
NGINX_PORT=8080

DB_DATABASE=opsora
DB_USERNAME=opsora
DB_PASSWORD=
DB_ROOT_PASSWORD=

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=